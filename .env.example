# Cloudflare D1 Database Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare R2 Object Storage (R1/R2) Configuration
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Management Portal & OTP Email Authentication (/manage)
MANAGE_ADMIN_EMAIL=your_email@gmail.com
AUTH_SECRET=your_super_secret_session_key

# SMTP Configuration to send login codes and contact notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="GNOME Portfolio" <your_email@gmail.com>

